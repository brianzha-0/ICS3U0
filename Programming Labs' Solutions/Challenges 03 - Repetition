def count_digits(num):
  # count the number of digits in num
  digit_count = 1
  while 10 ** digit_count <= abs(num):
    digit_count += 1
  return digit_count

def sum_digits(num):
  # calculate the sum of digits in num
  digit_sum = 0
  while 0 < num:
      digit_sum += num % 10
      num //= 10
  return digit_sum