def sum_even(start, end):
  # add all EVEN numbers between start and (including) end
  even_sum = 0 if start <= end else None
  if even_sum != None:
    for number in range(start + start % 2, end - end % 2 + 1, 2):
      even_sum += number
  return even_sum
